{
  "name": "treescore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "overrides": {
    "postcss": "8.5.28"
  },
  "description": "TreeScore — measure India's urban green cover clearly, honestly and consistently.",
  "scripts": {
    "predev": "npm run sync:data && npm run validate:data",
    "dev": "next dev",
    "prebuild": "npm run sync:data && npm run validate:data",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts tests --max-warnings=0",
    "format": "prettier --write src scripts tests",
    "typecheck": "tsc --noEmit",
    "sync:data": "node scripts/sync-boundaries.mjs",
    "validate:data": "node scripts/validate-data.ts",
    "gee:generate": "node scripts/generate-gee.mjs",
    "import:metrics": "node scripts/import-metrics.ts",
    "test": "node --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^15.5.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  }
}
